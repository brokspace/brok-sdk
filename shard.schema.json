{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/brokspace/brok-sdk/main/shard.schema.json",
  "title": "Brokspace shard manifest",
  "description": "shard.json: identity, capabilities and distribution of a Brokspace shard. Validated authoritatively by brok_sdk::ShardManifest::validate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Unique shard name."
    },
    "version": {
      "type": "string",
      "description": "Semantic version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string",
      "description": "SPDX expression."
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "brok": {
      "type": "string",
      "description": "Compatible brok versions, e.g. \">=0.1.0, <0.2.0\"."
    },
    "entrypoint": {
      "type": "string",
      "description": "Executable path relative to the shard directory (.exe is appended on Windows). Omit for skill-only shards."
    },
    "skills": {
      "type": "array",
      "description": "Directories (relative to the shard) whose subfolders each contain a SKILL.md agent skill.",
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "enum": [
        "native"
      ],
      "default": "native"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            }
          }
        },
        "network": {
          "type": "boolean",
          "default": false
        },
        "process": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/\\\\]+$"
          }
        },
        "env": {
          "type": "array",
          "description": "Variables passed through: exact names, PREFIX_* or *_SUFFIX. BROK_* is reserved.",
          "items": {
            "type": "string",
            "pattern": "^\\*?[A-Za-z0-9_]+\\*?$"
          }
        }
      }
    },
    "subscribes_to": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topicPattern"
      }
    },
    "publishes_to": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topicPattern"
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "artifact"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "artifact": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "releases": {
      "type": "object",
      "description": "Prebuilt binaries keyed by <os>-<arch> (e.g. linux-x86_64, macos-aarch64, windows-x86_64).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "sha256"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^[/\\\\])|(^[A-Za-z]:)|(\\.\\.)"
      }
    },
    "topicPattern": {
      "type": "string",
      "pattern": "^(\\*|[a-z0-9._-]+:[a-z0-9._-]*\\*?)$"
    }
  },
  "anyOf": [
    {
      "required": [
        "entrypoint"
      ]
    },
    {
      "required": [
        "skills"
      ]
    }
  ]
}
